{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lianmin-links",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": false
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "2c217fad5dc547a8a7b965d3f13dfefb",
      "id": "2c217fad5dc547a8a7b965d3f13dfefb"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lianmin-sink",
      "database_id": "28aa5bc7-89de-40d6-9f25-cb19288a552d",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "lianmin_sink"
    }
  ],
  "vars": {
    "NUXT_CF_ACCOUNT_ID": "67a3bd6eb33d80090214ceb3cb00856e",
    "NUXT_DATASET": "lianmin_sink",
    "NUXT_DISABLE_AUTO_BACKUP": "true",
    "NUXT_HOME_URL": "https://lianmin.pages.dev",
    "NUXT_PUBLIC_PREVIEW_MODE": "false"
  }
}
